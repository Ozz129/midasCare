{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Backend NestJS (Node 24, CommonJS)",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "removeComments": true,
    "types": ["node", "multer"]
  }
}
