{
  "name": "midas-care",
  "version": "0.1.0",
  "private": true,
  "description": "MIDAS CARE: plataforma SaaS multi-tenant de historias clínicas electrónicas (ecosistema MIDAS TECH).",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=12"
  },
  "prettier": "@care/config/prettier",
  "scripts": {
    "setup:local": "bash scripts/setup.sh",
    "dev": "pnpm build:packages && pnpm --parallel --filter \"./packages/*\" --filter @care/api --filter @care/web run dev",
    "dev:api": "pnpm build:packages && pnpm --filter @care/api run dev",
    "dev:web": "pnpm build:packages && pnpm --filter @care/web run dev",
    "build": "pnpm -r run build",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "build:api": "pnpm --filter @care/api... run build",
    "build:web": "pnpm --filter @care/web... run build",
    "start:api": "pnpm --filter @care/api run start",
    "preview:web": "pnpm --filter @care/web run preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:packages && pnpm -r run typecheck",
    "test": "pnpm build:packages && pnpm -r run test",
    "db:up": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env up -d",
    "db:down": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env down",
    "db:migrate": "pnpm build:api && pnpm --filter @care/api run db:migrate",
    "db:revert": "pnpm build:api && pnpm --filter @care/api run db:revert",
    "db:migration:create": "pnpm --filter @care/api run db:migration:create",
    "deploy:api:staging": "node scripts/deploy/deploy.mjs api staging",
    "deploy:web:staging": "node scripts/deploy/deploy.mjs web staging",
    "deploy:staging": "node scripts/deploy/deploy.mjs all staging",
    "deploy:production": "node scripts/deploy/deploy.mjs all production",
    "clean": "node scripts/build/clean.mjs"
  },
  "devDependencies": {
    "@care/config": "workspace:*",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.1"
  }
}
