# -----------------------------------------------------------------------------
# MIDAS CARE — Variables de la raíz del monorepo
# Usadas por Docker Compose (pnpm db:up). Copiar a .env y ajustar.
#
# Cada aplicación tiene su propio archivo de ejemplo:
#   apps/api/.env.example  -> backend (puerto, PostgreSQL, CORS, almacenamiento...)
#   apps/web/.env.example  -> frontend (URL pública de la API)
#
# Valores solo para desarrollo local. NUNCA usar estas credenciales fuera de local.
# -----------------------------------------------------------------------------

POSTGRES_USER=midas_care
POSTGRES_PASSWORD=midas_care_dev_password
POSTGRES_DB=midas_care
# Puerto publicado en el host (solo en 127.0.0.1)
POSTGRES_PORT=5432
