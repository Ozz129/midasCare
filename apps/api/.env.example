# -----------------------------------------------------------------------------
# MIDAS CARE — Backend API (NestJS)
# Copiar a apps/api/.env y ajustar. Las variables definidas en el entorno del
# proceso tienen prioridad sobre este archivo.
# NUNCA versionar credenciales reales. Los valores de ejemplo son solo locales.
# -----------------------------------------------------------------------------

# Entorno: development | staging | production | test
NODE_ENV=development

# Puerto HTTP de la API
API_PORT=3000

# URL pública de la API (sin /api/v1). Se usa en Swagger y enlaces absolutos.
API_PUBLIC_URL=http://localhost:3000

# Orígenes permitidos para CORS, separados por comas. No se admite "*".
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- PostgreSQL -----------------------------------------------------------------
# Debe coincidir con POSTGRES_* del .env raíz si se usa Docker Compose.
DATABASE_URL=postgres://midas_care:midas_care_dev_password@localhost:5432/midas_care
# true en staging/production si el servidor exige TLS (verifica el certificado).
DATABASE_SSL=false
# Registra consultas SQL (solo para depuración local; puede exponer datos).
DATABASE_LOGGING=false
# Reintentos de conexión al arrancar (0-20).
DATABASE_RETRY_ATTEMPTS=3

# --- Swagger ---------------------------------------------------------------------
# Por defecto: habilitado solo en development. Ruta: /api/docs
# SWAGGER_ENABLED=true

# --- Almacenamiento de archivos --------------------------------------------------
# Único driver disponible: local. La ruta NO debe estar servida públicamente.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# --- Autenticación ---------------------------------------------------------------
# Secreto para firmar los access tokens (JWT). OBLIGATORIO, mínimo 32 caracteres.
# Usar un valor distinto por entorno y no reutilizarlo nunca. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_ACCESS_TOKEN_SECRET=
# Vida del access token (60-3600 s). Por defecto 15 minutos.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# Vida de la sesión / refresh token (1 h - 90 días). Por defecto 30 días.
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
