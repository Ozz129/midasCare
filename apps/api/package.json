{
  "name": "@care/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de MIDAS CARE (NestJS, monolito modular).",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --watch",
    "db:migrate": "typeorm migration:run -d dist/infrastructure/database/data-source.js",
    "db:revert": "typeorm migration:revert -d dist/infrastructure/database/data-source.js",
    "db:migration:create": "typeorm migration:create",
    "db:migration:generate": "nest build && typeorm migration:generate -d dist/infrastructure/database/data-source.js --pretty"
  },
  "dependencies": {
    "@care/api-contracts": "workspace:*",
    "@care/shared-types": "workspace:*",
    "@care/shared-utils": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@care/config": "workspace:*",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "catalog:"
  },
  "jest": {
    "rootDir": ".",
    "testEnvironment": "node",
    "testRegex": ".*\\.(spec|e2e-spec)\\.ts$",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^@care/(api-contracts|shared-types|shared-utils)$": "<rootDir>/../../packages/$1/src/index.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
