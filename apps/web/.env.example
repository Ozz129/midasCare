# -----------------------------------------------------------------------------
# MIDAS CARE — Frontend web (Vite)
# Copiar a apps/web/.env (o .env.staging / .env.production) y ajustar.
# IMPORTANTE: toda variable VITE_* se incrusta en el bundle y es PÚBLICA.
# Nunca declarar aquí secretos, tokens ni credenciales.
# -----------------------------------------------------------------------------

# URL pública base de la API REST (incluye el prefijo /api/v1).
# En development, si se omite, se usa http://localhost:3000/api/v1.
# En builds de staging/production es OBLIGATORIA.
VITE_API_URL=http://localhost:3000/api/v1

# Entorno mostrado en la interfaz: development | staging | production
VITE_APP_ENV=development
